@page "/"
@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using System.Net
@using Promise.Comp.Components.Shared
@inject AppState appState
@inject NavigationManager navigationManager
@inject IMyEnvironment myEnvironment
@inject ISettings settings
@inject INavigationManager navigationManagerCrossplatform

<div class="container">
    <div class="row">
        <div class="col-xl-8 col-lg-10 col-md-12">
            <h1>Welcome to YouCent Promise App</h1>

            @if (isSignedIn)
            {
                <div class="alert alert-success mt-3" role="alert">
                    <h4 class="alert-heading">👋 Signed in as <strong>@username</strong></h4>
                    <p class="mb-0"><small>Share your username with others to receive YouCent Promises (YCP). Case doesn't matter!</small></p>
                </div>

                <div class="row mt-4">
                    <div class="col-md-4 mb-3">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">💰 Your Balance</h6>
                                <h2 class="card-title text-primary">@balance.ToString("N0") YCP</h2>
                                <p class="card-text"><small>Increases when you receive, decreases when you send</small></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">🎯 Promise Limit</h6>
                                <h2 class="card-title text-success">@limit.ToString("N0") YCP</h2>
                                <p class="card-text"><small>You can go negative up to this amount</small></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">✨ Available to Send</h6>
                                <h2 class="card-title text-info">@((limit + balance).ToString("N0")) YCP</h2>
                                <p class="card-text"><small>Maximum you can promise right now</small></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3" role="alert">
                    <strong>💡 Quick Info:</strong> YCP are digital promises, not real money. Exchange goods & services with your community. Keep your balance near zero by giving as much as you receive!
                </div>

                @if (userInforError is not null)
                {
                    <div class="alert alert-danger mt-3" role="alert">@userInforError</div>
                }
            }
        </div>
    </div>
</div>


<div class="container">
<div class="row">
        <div class="col-xl-8 col-lg-10 col-md-12">
        <br><br>
        <img src="_content/Promise.Comp/images/youcent-logo-brand.png" alt="YouCent logo" class="img-fluid" />
        <br><br>
        <h2>🚀 What is YouCent Promise actually is?</h2>
            <p><strong>Trade with promises, not cash!</strong> YouCent lets you buy and sell using YouCent Promises (YCP) – digital IOUs that you create by promising services or goods to your community. 🤝</p>
            <p>💡 <strong>How it works:</strong> Promise now, deliver later. Get what you need today by promising your talents tomorrow. Exchange rate: 100 YCP = 1 USD (for reference only).</p>
            <p>✨ <strong>100% Free transactions.</strong> Optional annual fee unlocks your Promise Limit to spend beyond zero balance. No investors, no hidden fees – just community exchange!</p>
            <p><em>Keep your balance near zero by giving as much as you receive. Respect the community, keep your promises, and let's build something amazing together! 🌟</em></p>
        </div>
    </div>
</div>


<br><br>
