@page "/"
@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using System.Net
@using Promise.Comp.Components.Shared
@inject AppState appState
@inject NavigationManager navigationManager
@inject IMyEnvironment myEnvironment
@inject ISettings settings
@inject INavigationManager navigationManagerCrossplatform

<div class="container">
    <div class="row">
        <div class="col-xl-8 col-lg-10 col-md-12">
            <h1>Welcome to YouCent Promise App</h1>

            @if (isSignedIn)
            {
                <div class="alert alert-success mt-3" role="alert">
                    <h4 class="alert-heading">👋 Signed in as <strong>@username</strong></h4>
                    <p class="mb-0"><small>Share your username with others to receive YouCent Promises (YCP). Case doesn't matter!</small></p>
                </div>

                @if (!string.IsNullOrEmpty(appState.UserCurrencyCode))
                {
                    <div class="text-end mb-2">
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input" type="checkbox" id="currencyToggle" @bind="showInUserCurrency">
                            <label class="form-check-label" for="currencyToggle">
                                <small>Show in @appState.UserCurrencyCode</small>
                            </label>
                        </div>
                        @if (showInUserCurrency)
                        {
                            <span class="ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Approximate values. All transactions are processed in YouCent Promises (YCP).">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle text-muted" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                    <path d="M8.93 6.588l-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                                </svg>
                            </span>
                        }
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-md-4 mb-3">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">💰 Your Balance</h6>
                                <h2 class="card-title text-primary">
                                    <AmountDisplay Amount="@((long)balance)" UseCurrency="@showInUserCurrency" />
                                </h2>
                                <p class="card-text"><small>Increases when you receive, decreases when you send</small></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">🎯 Promise Limit</h6>
                                <h2 class="card-title text-success">
                                    <AmountDisplay Amount="@((long)limit)" UseCurrency="@showInUserCurrency" />
                                </h2>
                                <p class="card-text"><small>You can go negative up to this amount</small></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card text-center shadow-sm">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">✨ Available to Send</h6>
                                <h2 class="card-title text-info">
                                    <AmountDisplay Amount="@((long)(limit + balance))" UseCurrency="@showInUserCurrency" />
                                </h2>
                                <p class="card-text"><small>Maximum you can promise right now</small></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3" role="alert">
                    <strong>💡 Quick Info:</strong> YCP are digital promises, not real money. Exchange goods & services with your community. Keep your balance near zero by giving as much as you receive!
                </div>

                @if (userInforError is not null)
                {
                    <div class="alert alert-danger mt-3" role="alert">@userInforError</div>
                }
            }
        </div>
    </div>
</div>


<div class="container">
<div class="row">
        <div class="col-xl-8 col-lg-10 col-md-12">
        <br><br>
        <img src="_content/Promise.Comp/images/youcent-logo-brand.png" alt="YouCent logo" class="img-fluid" />
        <br><br>
        <h2>🚀 What is YouCent Promise actually is?</h2>
            <p><strong>Trade with promises, not cash!</strong> YouCent lets you buy and sell using YouCent Promises (YCP) – digital IOUs that you create by promising services or goods to your community. 🤝</p>
            <p>💡 <strong>How it works:</strong> Promise now, deliver later. Get what you need today by promising your talents tomorrow. Exchange rate: 100 YCP = 1 USD (for reference only).</p>
            <p>✨ <strong>100% Free transactions.</strong> Optional annual fee unlocks your Promise Limit to spend beyond zero balance. No investors, no hidden fees – just community exchange!</p>
            <p><em>Keep your balance near zero by giving as much as you receive. Respect the community, keep your promises, and let's build something amazing together! 🌟</em></p>
        </div>
    </div>
</div>


<br><br>
<div class="container">
    <div class="row">
        <div class="col-xl-8 col-lg-10 col-md-12">
            <h2>💪 Join the Movement!</h2>
            <p><strong>YouCent runs on passion, not profit.</strong> Built by volunteers who believe in community-powered exchange. No investors. No corporate agenda. Just real people creating real change. 🌍</p>
            <p>🎯 <strong>Your support fuels our mission:</strong> Cover infrastructure, reward dedicated volunteers, and scale this tool worldwide. Every contribution brings us closer to sustainability.</p>
            <p class="text-center" style="font-size: 1.2em; margin-top: 20px;">
                <strong>❤️ Support Us Now:</strong><br>
                <a href="https://patreon.com/youcent" target="_blank" class="btn btn-primary btn-lg m-2">🎁 Become a Patron</a>
                <a href="https://paypal.me/youcentapp" target="_blank" class="btn btn-primary btn-lg m-2">💰 Donate via PayPal</a>
            </p>
            <p class="text-center"><em>Together, we're building the future of community exchange. Be part of it! 🚀</em></p>
        </div>
    </div>
</div>

<br><br>

<div class="container">
    <div class="row">
        <div class="col-xl-8 col-lg-10 col-md-12">
            <h2>📬 Get in Touch</h2>
            <p style="font-size: 1.1em;">
                📧 <strong>Email:</strong> <a href="mailto:arkfen@youcent.app">arkfen@youcent.app</a><br>
                💬 <strong>WhatsApp:</strong> <a href="https://wa.me/14384552490">+1 (438) 455-2490</a><br>
                ✖️ <strong>X (Twitter):</strong> <a href="https://twitter.com/YouCentApp">@@YouCentApp</a>
            </p>
            <p><em>Questions? Ideas? Feedback? We'd love to hear from you! 💙</em></p>
        </div>
    </div>
</div>

<br><br>


<PrivacyPolicyContent />
<br>
<br>


@code {
    private bool isSignedIn = false;
    private string? username;
    private bool isAuthError = false;
    private string? userInforError;
    private decimal balance;
    private decimal limit;
    private string api => settings.ApiEndpoint;
    private bool showInUserCurrency = false;
    

    protected override async Task OnInitializedAsync()
    {
        // Check if app update is required
        if (myEnvironment.IsNative() && appState.IsUpdateRequired && navigationManagerCrossplatform != null)
        {
            await navigationManagerCrossplatform.NavigateToAsync("///UpdateApp");
            return;
        }

        isSignedIn = appState.IsSignedIn;
        if (isSignedIn)
        {
            username = appState.Username;
            ApiResponseUserInfo? userInfo = await GetUserInformation(username);
            if (!isAuthError && userInfo is not null)
            {
                balance = userInfo.Balance;
                limit = userInfo.PromiseLimit;
            }
            
            // Load user currency info
            await LoadUserCurrency();
        }
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (isAuthError)
        {
            navigationManager.NavigateTo("/signout");
        }
        if (appState.IsCutOff)
        {
            navigationManager.NavigateTo("/cutoff");
        }
        // Also check for required updates
        if (myEnvironment.IsNative() && appState.IsUpdateRequired && firstRender)
        {
            Task.Run(async () => await navigationManagerCrossplatform.NavigateToAsync("///UpdateApp"));
        }
    }

    private async Task<ApiResponseUserInfo?> GetUserInformation(string? username)
    {
        if (username is null)
        {
            isAuthError = true;
            return null;
        }
        var user = new User { Login = username };
        var json = JsonSerializer.Serialize(user);
        var request = new HttpRequestMessage(HttpMethod.Post, $"{api}/userinfo");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", appState.Token);
        request.Content = new StringContent(json, Encoding.UTF8, "application/json");

        try
        {
            using var httpClient = new HttpClient();
            var response = await httpClient.SendAsync(request);

            var responseObject = await response.Content.ReadFromJsonAsync<ApiResponseUserInfo>();

            if (response.IsSuccessStatusCode)
            {
                if (responseObject is not null && responseObject.Success)
                {
                    return responseObject;
                }
                else
                {
                    MainLogger.LogError("Error in GetUserInformation on Home page: " + responseObject?.Error);
                    userInforError = "Sorry, we couldn't get your information. Please try again later.";
                }
            }
            else
            {
                if (response.StatusCode == HttpStatusCode.Unauthorized)
                {
                    isAuthError = true;
                }
                else
                {
                    MainLogger.LogError("Error in GetUserInformation on Home page. Response code: " + response.StatusCode + ". Response error: " + responseObject?.Error);
                    userInforError = "Sorry, we couldn't get your information. Please try again later.";
                }
            }
        }
        catch (HttpRequestException ex)
        {
            MainLogger.LogError("Network error in GetUserInformation on Home page: " + ex.Message);
            userInforError = "Network error. Please check your internet connection and try again.";
        }
        catch (Exception ex)
        {
            MainLogger.LogError("Unexpected error in GetUserInformation on Home page: " + ex.Message);
            userInforError = "An unexpected error occurred. Please try again later.";
        }

        return null;
    }

    private async Task LoadUserCurrency()
    {
        try
        {
            var user = new User
            {
                Login = appState.Username,
                Id = appState.UserId
            };

            var json = JsonSerializer.Serialize(user);
            var request = new HttpRequestMessage(HttpMethod.Post, $"{api}/getusercurrency");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", appState.Token);
            request.Content = new StringContent(json, Encoding.UTF8, "application/json");

            using var httpClient = new HttpClient();
            var response = await httpClient.SendAsync(request);
            var responseJson = await response.Content.ReadAsStringAsync();
            var responseObject = JsonSerializer.Deserialize<JsonElement>(responseJson);

            if (response.IsSuccessStatusCode && responseObject.GetProperty("success").GetBoolean())
            {
                appState.UserCurrencyId = responseObject.GetProperty("currencyId").GetByte();
                appState.UserCurrencyCode = responseObject.GetProperty("currencyCode").GetString();
                appState.UserCurrencyRate = responseObject.GetProperty("amountFor100").GetDouble();
            }
        }
        catch (Exception ex)
        {
            MainLogger.LogError($"Error loading user currency: {ex.Message}");
            // Non-critical error, continue without currency info
        }
    }
    
}
